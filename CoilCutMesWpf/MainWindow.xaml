<Window x:Class="CoilCutMesWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Monitor MES - Taglio bobine" Height="760" Width="1180"
        MinHeight="680" MinWidth="1020"
        Background="#F4F7FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE5ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#536171"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C6D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DDE5ED"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Monitor MES per il taglio bobine"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#162233"/>
                <TextBlock Text="Simulazione del taglio della bobina, calcolo del piano di lavoro e invio dei dati al MES"
                           FontSize="14"
                           Foreground="#607083"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Background="#E7F6EF"
                    BorderBrush="#B9E4D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#20A464" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding MesStatus}" Foreground="#17643F" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Parametri bobina" FontSize="18" FontWeight="Bold" Foreground="#1E2A38"/>
                            <TextBlock Text="Dati di produzione usati per simulare il taglio longitudinale."
                                       Foreground="#6A7786"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,16"/>

                            <TextBlock Text="Codice ordine" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding OrderCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="ID bobina" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding CoilId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Larghezza bobina madre (mm)" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding MotherCoilWidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Larghezza nastro richiesto (mm)" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding StripWidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Numero nastri richiesti" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding RequestedStripsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Lunghezza bobina (m)" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding CoilLengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Calcola piano"
                            Background="#235789"
                            Foreground="White"
                            BorderBrush="#235789"
                            Click="CalculateButton_Click"/>
                    <Button Grid.Column="2"
                            Content="Invia al MES"
                            Background="#2E7D5A"
                            Foreground="White"
                            BorderBrush="#2E7D5A"
                            Click="SendMesButton_Click"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Piano di taglio" FontSize="18" FontWeight="Bold" Foreground="#1E2A38"/>
                            <TextBlock Text="Ogni riga rappresenta un nastro generato dalla bobina madre."
                                       Foreground="#6A7786"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding CutPlanRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="55"/>
                                <DataGridTextColumn Header="ID nastro" Binding="{Binding StripId}" Width="130"/>
                                <DataGridTextColumn Header="Larghezza mm" Binding="{Binding WidthMm}" Width="120"/>
                                <DataGridTextColumn Header="Lunghezza m" Binding="{Binding LengthM}" Width="120"/>
                                <DataGridTextColumn Header="Destinazione" Binding="{Binding Destination}" Width="*"/>
                                <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="Sintesi" FontSize="18" FontWeight="Bold" Foreground="#1E2A38" Margin="0,0,0,12"/>
                            <TextBlock Text="Nastri ottenibili" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding AvailableStrips}" FontSize="24" FontWeight="Bold" Foreground="#235789" Margin="0,0,0,8"/>
                            <TextBlock Text="Scarto laterale" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding ScrapWidthDisplay}" FontSize="22" FontWeight="Bold" Foreground="#B7562A" Margin="0,0,0,8"/>
                            <TextBlock Text="Efficienza" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding EfficiencyDisplay}" FontSize="22" FontWeight="Bold" Foreground="#2E7D5A"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Eventi produzione" FontSize="18" FontWeight="Bold" Foreground="#1E2A38" Margin="0,0,0,12"/>
                            <ListBox ItemsSource="{Binding ProductionEvents}" BorderBrush="#DDE5ED">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#162233"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#607083" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Dati JSON inviati al MES" FontSize="18" FontWeight="Bold" Foreground="#1E2A38" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding LastMesPayload, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     BorderBrush="#DDE5ED"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

