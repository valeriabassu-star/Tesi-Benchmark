<Window x:Class="CoilCutOperatorHmiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pannello operatore - Taglio bobine" Height="760" Width="1220"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F5">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1DAE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5D6978"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#142033"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BBC8D6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1DAE3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Pannello operatore per il taglio bobine"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#101B2A"/>
                <TextBlock Text="Gestione dell'ordine, dei parametri della macchina e dell'avanzamento del taglio"
                           FontSize="14"
                           Foreground="#607083"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Background="{Binding MachineStateBackground}"
                    BorderBrush="{Binding MachineStateBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,9"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="11" Height="11" Fill="{Binding MachineStateBrush}" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding MachineState}" FontWeight="Bold" Foreground="{Binding MachineStateBrush}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Ordine e ricetta" FontSize="19" FontWeight="Bold" Foreground="#142033"/>
                            <TextBlock Text="Parametri inviati alla macchina prima dell'avvio del ciclo."
                                       Foreground="#637285"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,16"/>

                            <TextBlock Text="Ordine produzione" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Codice bobina" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding CoilCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Larghezza bobina madre (mm)" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding CoilWidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Larghezza nastro (mm)" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding StripWidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Numero lame attive" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding ActiveBladesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Velocità della linea impostata (m/min)" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding SpeedSetpointText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Lunghezza da raggiungere (m)" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding TargetLengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                            <CheckBox Content="Abilita invio dati produzione al MES"
                                      IsChecked="{Binding SendToMes}"
                                      FontSize="13"
                                      Foreground="#304155"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,12,0,0">
                    <Button Content="Carica ricetta"
                            Margin="0,0,6,6"
                            Style="{StaticResource CommandButton}"
                            Background="#2F5E8E"
                            Foreground="White"
                            BorderBrush="#2F5E8E"
                            Click="LoadRecipeButton_Click"/>
                    <Button Content="Avvia"
                            Margin="6,0,0,6"
                            Style="{StaticResource CommandButton}"
                            Background="#238457"
                            Foreground="White"
                            BorderBrush="#238457"
                            Click="StartButton_Click"/>
                    <Button Content="Pausa"
                            Margin="0,6,6,0"
                            Style="{StaticResource CommandButton}"
                            Background="#C88C1A"
                            Foreground="White"
                            BorderBrush="#C88C1A"
                            Click="PauseButton_Click"/>
                    <Button Content="Arresta"
                            Margin="6,6,0,0"
                            Style="{StaticResource CommandButton}"
                            Background="#B63535"
                            Foreground="White"
                            BorderBrush="#B63535"
                            Click="StopButton_Click"/>
                </UniformGrid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="210"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Velocità effettiva" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="{Binding ActualSpeedDisplay}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding SpeedPercent, Mode=OneWay}" Maximum="100" Height="9" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Avanzamento" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="{Binding ProgressDisplay}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="9" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Tensione nastro" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="{Binding TensionDisplay}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding TensionPercent, Mode=OneWay}" Maximum="100" Height="9" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Scarto stimato" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="{Binding ScrapDisplay}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="{Binding MesTransferStatus}" Foreground="#607083" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Schema della macchina" FontSize="19" FontWeight="Bold" Foreground="#142033" Margin="0,0,0,16"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Svolgitore" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#304155"/>
                                <Ellipse Width="88" Height="88" Fill="#DDE7F0" Stroke="#8395A7" StrokeThickness="3" Margin="0,10,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center" Height="170">
                                <Rectangle Height="42" Fill="#AEBCCB" RadiusX="4" RadiusY="4" VerticalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding BladePositions}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"
                                                         Columns="{Binding DataContext.BladeLayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="44" HorizontalAlignment="Center">
                                                <Polygon Points="22,0 42,52 2,52" Fill="#C84738"/>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Riavvolgitore" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#304155"/>
                                <Ellipse Width="88" Height="88" Fill="#DDE7F0" Stroke="#8395A7" StrokeThickness="3" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Allarmi e messaggi macchina" FontSize="19" FontWeight="Bold" Foreground="#142033" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding MachineMessages}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ora" Binding="{Binding Time}" Width="78"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Level}" Width="95"/>
                                    <DataGridTextColumn Header="Messaggio" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Dati inviati al controllo della macchina" FontSize="19" FontWeight="Bold" Foreground="#142033" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding PlcPayload, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     BorderBrush="#D1DAE3"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
